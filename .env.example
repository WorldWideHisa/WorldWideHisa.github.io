# Google Analytics 4 測定ID
# GA4のプロパティ作成後に取得したIDをコピーして .env に設定する
NUXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# 記事リポジトリ（wwh-blog-content）の場所（ローカル開発用・任意）
# 未設定ならこのリポジトリの ./content を使う（CI と同じ）。
# 別の場所に clone している場合は、記事リポジトリのルート（articles/ がある階層）を指定する
# BLOG_CONTENT_DIR=../wwh-blog-content

# ---- ローカル管理画面の画像アップロード（任意・npm run dev のときだけ使う）----
# Cloudflare のダッシュボード > R2 > API トークンで、
# 「オブジェクトの読み取りと書き込み」「対象バケットだけ」に絞ったトークンを作って設定する
# R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_BUCKET=バケット名
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# 画像を公開している URL（独自ドメイン）
# R2_PUBLIC_URL=https://images.worldwidehisa.net
# 画像を変換する hisa-compress の URL（既定 http://localhost:8000）
# HISA_COMPRESS_URL=http://localhost:8000
